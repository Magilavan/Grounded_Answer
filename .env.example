# Copy this file to .env and fill in values as needed.
# Every value below has a sensible default in app/config.py -- .env is
# only needed to override one, most commonly LLM_API_KEY.

# --- LLM (optional) ----------------------------------------------------
# The system works fully without an LLM: with no key set, answers are
# built directly from verified evidence text (see DECISIONS.md). Setting
# LLM_API_KEY enables an LLM to phrase the final answer sentence -- its
# output still passes through citation validation before being shown, so
# it can never introduce an uncited or invented clause.
#
# Default provider is Groq's OpenAI-compatible chat completions API.
# Get a key at https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here
LLM_API_BASE=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile
LLM_ENABLED=true

# --- Paths ---------------------------------------------------------------
POLICY_MANUAL_PATH=data/policy-manual.md
INDEX_PATH=data/index

# --- Retrieval -----------------------------------------------------------
RETRIEVAL_TOP_K=12
RERANK_TOP_K=6
RRF_K=60

# --- Evidence sufficiency thresholds --------------------------------------
MIN_RELEVANCE_SCORE=0.12
MIN_SUPPORT_SCORE=0.34

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO
